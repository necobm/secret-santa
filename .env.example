# Database (libSQL, ADR-0004).
# Local development: a SQLite file (this is the default if unset). No token needed.
TURSO_DATABASE_URL=file:data/secret-santa.db
# Production (Turso): libsql://<db>-<user>.turso.io and a token from `turso db tokens create <db>`.
# TURSO_DATABASE_URL=libsql://secret-santa-xxxx.turso.io
# TURSO_AUTH_TOKEN=
